# Copy to 02-secret.yaml, fill in the real token, and DO NOT commit it.
# Alternatively create it imperatively so nothing sensitive ever touches git:
#   kubectl create secret generic ai-va-secret \
#     --namespace ai-virtual-assistant \
#     --from-literal=HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
apiVersion: v1
kind: Secret
metadata:
  name: ai-va-secret
  namespace: ai-virtual-assistant
type: Opaque
stringData:
  HF_API_TOKEN: "hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
