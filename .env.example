# Copy this file to .env and fill in real values. Never commit the real .env.
#
# Get a free Hugging Face access token (read scope is enough) at:
#   https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any text-generation/conversational model on the HF Hub that supports the
# chat-completion Inference API task, e.g.:
#   HF_MODEL_ID=openai/gpt-oss-20b
#   mistralai/Mistral-7B-Instruct-v0.2
HF_MODEL_ID=openai/gpt-oss-20b

# Assistant behaviour
SYSTEM_PROMPT="You are a helpful, concise virtual assistant. Answer clearly and admit when you are not sure."
MAX_NEW_TOKENS=512
TEMPERATURE=0.7

# Ops
LOG_LEVEL=INFO

# Frontend -> backend wiring (only needed when NOT using docker-compose,
# e.g. running both processes locally with `uvicorn`/`streamlit run`)
BACKEND_URL=http://localhost:8000
API_PREFIX=/api/v1
